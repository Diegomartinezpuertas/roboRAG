<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_dashboard</name>
  <version>0.0.0</version>
  <description>Web dashboard for observability and goal dispatch (text/voice)</description>
  <maintainer email="diegoamartinezpuertas@gmail.com">diego</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>robot_interfaces</depend>
  <depend>robot_zones</depend>
  <depend>tf2_ros_py</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
